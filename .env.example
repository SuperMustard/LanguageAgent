# 复制为 .env，填入你自己的 key。.env 已在 .gitignore 里，不会被提交。

# Groq API key —— https://console.groq.com/keys
GROQ_API_KEY=

# 可选：不填则用默认值
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

# Azure Speech key（TTS 用）—— https://portal.azure.com 建 Speech resource 后在 Keys 页面拿
# voice_bot.py（Pipecat 语音层）必需，不填会连不上语音 bot。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 可选：SQLite 数据库路径，不填则用 ~/.local/share/languageagent/agent.db
# LANGPRACTICE_DB=

# 可选：导出文件输出目录，不填则用数据库同目录下的 exports/
# LANGPRACTICE_EXPORT_DIR=

# 可选：VAD 断句参数（voice_bot.py），改完要重启语音 bot 进程才生效
# stop_secs 是"多久静音才算说完了"——嫌被切太快就调大（比如 1.2），嫌 AI 接话慢就调小
# VAD_CONFIDENCE=0.7
# VAD_START_SECS=0.2
# VAD_STOP_SECS=0.8
# VAD_MIN_VOLUME=0.6
