# 复制为 .env，填入你自己的 key。.env 已在 .gitignore 里，不会被提交。

# Groq API key —— https://console.groq.com/keys
GROQ_API_KEY=

# 可选：不填则用默认值
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

# Azure Speech key（TTS 用）—— https://portal.azure.com 建 Speech resource 后在 Keys 页面拿
# 没填时自动退回 MockTTSClient（返回一段占位提示音，不报错）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 可选：SQLite 数据库路径，不填则用 ~/.local/share/languageagent/agent.db
# LANGPRACTICE_DB=

# 可选：导出文件输出目录，不填则用数据库同目录下的 exports/
# LANGPRACTICE_EXPORT_DIR=
